# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgrespassword"
DB_NAME="sistemagis"

# Server Configuration
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="super-secret-key-for-development"
BETTER_AUTH_URL="http://localhost:3000"

# Social Authentication (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# MQTT Configuration (Set to true if connecting to real IoT broker)
MQTT_URL="mqtt://test.mosquitto.org"
ENABLE_MQTT=false

# Security & Integration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
PAYMENT_WEBHOOK_SECRET="change-this-to-a-secure-random-secret-in-production"

